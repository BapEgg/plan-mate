        { "expr": "planmate_itinerary_generation_worker_delivery_total{redelivered=\"true\"}", "legendFormat": "RabbitMQ가 다시 전달한 메시지", "refId": "B" },
        { "expr": "planmate_itinerary_generation_worker_processed_total{result=\"skipped\"}", "legendFormat": "이미 처리되어 건너뜀 (SKIP)", "refId": "C" }
      ],
      "title": "④ 재전달 1건을 감지하고 중복 처리 차단",
